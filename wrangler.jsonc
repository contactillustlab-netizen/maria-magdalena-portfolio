{
  "name": "maria-magdalena-portfolio",
  "compatibility_date": "2026-08-04",
  // The site is reachable only at magdavizireanu.com. Without this, a deploy
  // re-enables the workers.dev route, which would serve the whole portfolio a
  // second time on a hostname Google could index alongside the real one.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Request logs stay off: this Worker only serves static files, so there is
  // nothing to debug in them. Declared here so a deploy cannot flip it back.
  "observability": {
    "enabled": false
  }
}
